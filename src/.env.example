APP_NAME=bsw-bet-maker
ENVIRONMENT=local
DEBUG=false

LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bsw_bet_maker
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
REDIS_EVENTS_TTL_SECONDS=300
REDIS_MAX_CONNECTIONS=10

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Must match bsw-line-provider publish + queue bindings
RABBITMQ_EXCHANGE=events
RABBITMQ_EVENT_CREATED_ROUTING_KEY=event.created
RABBITMQ_EVENT_UPDATED_ROUTING_KEY=event.updated
RABBITMQ_ADD_EVENT_QUEUE=bet-maker.event.created
RABBITMQ_UPDATE_EVENT_STATUS_QUEUE=bet-maker.event.updated

LINE_PROVIDER_BASE_URL=http://localhost:8020
LINE_PROVIDER_API_KEY=
LINE_PROVIDER_TIMEOUT_SECONDS=30

JWT_SECRET_KEY=jwt-secret-xxxxx
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
